# Merenda Check — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com chaves reais!

# Chave da API da OpenAI (assistente Checky)
# Obtenha em: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sua_chave_openai_aqui

# Supabase — Banco de dados real
# Crie um projeto em: https://supabase.com (gratuito)
# Acesse Settings -> API para obter os valores abaixo
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui
